{
  "name": "email-island",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "srvx --prod --host 0.0.0.0 --port 3000 --static ../client dist/server/server.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:human": "eslint --config eslint.human.js",
    "lint:deps": "depcruise src --config .dependency-cruiser.js --exclude \"routeTree[.]gen[.]ts$\" --output-type err",
    "format": "prettier --write src/",
    "harness-signal": "bash scripts/harnessSignal.sh",
    "sync:skills": "node .agents/scripts/syncSkills.mjs",
    "knip": "knip",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src/",
    "auth:generate": "auth generate --config scripts/auth-schema.config.ts --output src/lib/auth-schema.sql --yes",
    "worker": "node --import tsx src/features/classifier/worker.server.ts",
    "jev:fixture": "node --import tsx src/features/classifier/jev-fixture.server.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "@typesafe-ai/sdk": "0.7.0",
    "better-auth": "1.7.18",
    "bullmq": "6.7.2",
    "clsx": "^2.1.1",
    "ioredis": "6.0.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "srvx": "1.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/eslint-plugin-query": "^5.105.3",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "auth": "1.7.18",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
